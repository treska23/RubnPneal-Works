<Window x:Class="AulaManagerWpf.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:sys="clr-namespace:System;assembly=mscorlib"
 Title="Aula Manager Portable · Mantenimiento de aulas" Width="1390" Height="900"
 MinWidth="800" MinHeight="560" WindowStartupLocation="CenterScreen"
 Background="{StaticResource AppBackground}" UseLayoutRounding="True"
 SnapsToDevicePixels="True">
 <Window.Resources>
  <Style x:Key="CaptionStyle" TargetType="TextBlock">
   <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="#285A8A"/>
   <Setter Property="Margin" Value="0,0,0,7"/><Setter Property="TextWrapping" Value="Wrap"/>
  </Style>
  <Style x:Key="StatRow" TargetType="Grid">
   <Setter Property="Margin" Value="0,0,0,10"/>
  </Style>
 </Window.Resources>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="40"/></Grid.RowDefinitions>
  <Grid.ColumnDefinitions><ColumnDefinition Width="236"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Grid.Column="0" Grid.Row="0" BorderBrush="#D5E9F8" BorderThickness="0,0,1,0">
   <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#E1F2FF" Offset="0"/><GradientStop Color="#F5FBFF" Offset="1"/>
   </LinearGradientBrush></Border.Background>
   <DockPanel LastChildFill="True" Margin="17,22,17,18">
    <StackPanel DockPanel.Dock="Top">
     <StackPanel Orientation="Horizontal" Margin="4,0,0,20">
      <Border Width="56" Height="56" Background="#2C9CEB" CornerRadius="13" Margin="0,0,11,0">
       <Grid>
        <TextBlock Text="▣" FontSize="31" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <Ellipse Width="12" Height="12" Fill="#16D6AA" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,7,6"/>
       </Grid>
      </Border>
      <StackPanel VerticalAlignment="Center">
       <TextBlock Text="AULA" FontWeight="Bold" FontSize="21" Foreground="#123C68"/>
       <TextBlock Text="MANAGER" FontWeight="Bold" FontSize="19" Foreground="#123C68"/>
       <TextBlock Text="PORTABLE  ·  v0.4.2" FontSize="10.5" Foreground="#3C83B7"/>
      </StackPanel>
     </StackPanel>
     <Separator Background="#D5E9F8" Margin="0,0,0,16"/>
     <Button x:Name="NavOverview" Tag="0" Click="Navigate_Click" Style="{StaticResource NavButton}"
      Content="⌂   Resumen" Background="#208FE6" Foreground="White"/>
     <Button x:Name="NavMaintenance" Tag="1" Click="Navigate_Click" Style="{StaticResource NavButton}" Content="✦   Mantenimiento"/>
     <Button x:Name="NavPrograms" Tag="2" Click="Navigate_Click" Style="{StaticResource NavButton}" Content="◆   Programas / antivirus"/>
     <Button x:Name="NavLibre" Tag="3" Click="Navigate_Click" Style="{StaticResource NavButton}" Content="▤   LibreOffice"/>
     <Button x:Name="NavMigration" Tag="4" Click="Navigate_Click" Style="{StaticResource NavButton}" Content="▣   Migración Windows"/>
     <Button x:Name="NavReports" Tag="5" Click="Navigate_Click" Style="{StaticResource NavButton}" Content="▤   Informes"/>
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom">
     <Separator Background="#D5E9F8" Margin="0,0,0,17"/>
     <TextBlock Text="●  EQUIPO LISTO" FontWeight="SemiBold" Foreground="#169C82" Margin="5,0,0,9"/>
     <TextBlock Text="Modo portable · sin instalador" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="5,0,0,4"/>
     <TextBlock Text="Datos guardados junto al programa" FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="5,0,0,0"/>
    </StackPanel>
   </DockPanel>
  </Border>

  <ScrollViewer Grid.Column="1" Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
   Padding="0" CanContentScroll="False">
   <Grid Margin="24,24,25,25" MinWidth="720">

    <!-- RESUMEN -->
    <StackPanel x:Name="PageOverview">
     <Border Style="{StaticResource Card}" Margin="0,0,0,15" Background="#DDF7ED">
      <StackPanel>
       <Button x:Name="RunAllOverviewButton" Content="Hacer todo el mantenimiento" Click="RunAll_Click"
               Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"/>
       <TextBlock Text="Limpieza, CEIP/telemetría, servicios, actualización de LibreOffice e informe final en una sola ejecución. Requiere identificar el puesto y permisos de administrador."
                  TextWrapping="Wrap" Margin="0,10,0,0"/>
      </StackPanel>
     </Border>
     <Border CornerRadius="17" Padding="25,22" Margin="0,0,0,15">
      <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
       <GradientStop Color="#DCEFFF" Offset="0"/><GradientStop Color="#F0FAFF" Offset="1"/>
      </LinearGradientBrush></Border.Background>
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
       <StackPanel VerticalAlignment="Center">
        <TextBlock Text="Resumen del equipo" Style="{StaticResource H1}"/>
        <TextBlock Text="Información del sistema y acceso rápido a las tareas de mantenimiento."
         Foreground="#537DA2" FontSize="14.5" TextWrapping="Wrap" Margin="0,7,0,0"/>
       </StackPanel>
       <Border Grid.Column="1" Width="75" Height="75" Background="#D1EAFF"
               HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="14">
        <TextBlock Text="▣" FontSize="43" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#117DCE"/>
       </Border>
      </Grid>
     </Border>

     <Border Style="{StaticResource Card}" Margin="0,0,0,15" Padding="18">
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition Width="5*"/><ColumnDefinition Width="3*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <StackPanel Grid.Column="0" Margin="0,0,15,0">
        <TextBlock Text="Centro municipal" Style="{StaticResource CaptionStyle}"/>
        <TextBox x:Name="CenterBox" ToolTip="Nombre del centro municipal"/>
       </StackPanel>
       <StackPanel Grid.Column="1" Margin="0,0,15,0">
        <TextBlock Text="Puesto físico" Style="{StaticResource CaptionStyle}"/>
        <TextBox x:Name="StationBox" ToolTip="Identifica el ordenador físico: PC1, PC2, Profesor…"/>
       </StackPanel>
       <Button Grid.Column="2" Content="Guardar identificación" Click="SaveIdentity_Click" VerticalAlignment="Bottom"
        Style="{StaticResource PrimaryButton}" Padding="17,9" Margin="0,0,0,0"/>
      </Grid>
     </Border>

     <Grid Margin="0,0,0,15">
      <Grid.ColumnDefinitions><ColumnDefinition Width="1.68*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,8,0" MinHeight="335">
       <StackPanel>
        <TextBlock Text="▣  Información del equipo" Style="{StaticResource H2}" Margin="0,0,0,20"/>
        <Grid>
         <Grid.ColumnDefinitions><ColumnDefinition Width="175"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
         <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
         </Grid.RowDefinitions>
         <TextBlock Grid.Row="0" Text="Nombre del equipo" Margin="0,0,8,11" FontWeight="SemiBold"/>
         <TextBlock Grid.Row="0" Grid.Column="1" x:Name="PcNameText" TextWrapping="Wrap" Margin="0,0,0,11"/>
         <TextBlock Grid.Row="1" Text="Sistema operativo" Margin="0,0,8,11" FontWeight="SemiBold"/>
         <TextBlock Grid.Row="1" Grid.Column="1" x:Name="OsText" TextWrapping="Wrap" Margin="0,0,0,11"/>
         <TextBlock Grid.Row="2" Text="Arquitectura" Margin="0,0,8,11" FontWeight="SemiBold"/>
         <TextBlock Grid.Row="2" Grid.Column="1" x:Name="ArchText" TextWrapping="Wrap" Margin="0,0,0,11"/>
         <TextBlock Grid.Row="3" Text="Procesador" Margin="0,0,8,11" FontWeight="SemiBold"/>
         <TextBlock Grid.Row="3" Grid.Column="1" x:Name="CpuText" TextWrapping="Wrap" Margin="0,0,0,11"/>
         <TextBlock Grid.Row="4" Text="Memoria RAM" Margin="0,0,8,11" FontWeight="SemiBold"/>
         <TextBlock Grid.Row="4" Grid.Column="1" x:Name="RamText" TextWrapping="Wrap" Margin="0,0,0,11"/>
         <TextBlock Grid.Row="5" Text="Espacio libre (C:)" Margin="0,0,8,11" FontWeight="SemiBold"/>
         <TextBlock Grid.Row="5" Grid.Column="1" x:Name="DiskText" TextWrapping="Wrap" Margin="0,0,0,11"/>
         <TextBlock Grid.Row="6" Text="LibreOffice" Margin="0,0,8,11" FontWeight="SemiBold"/>
         <TextBlock Grid.Row="6" Grid.Column="1" x:Name="LibreText" TextWrapping="Wrap" Margin="0,0,0,11"/>
         <TextBlock Grid.Row="7" Text="Administrador" Margin="0,0,8,11" FontWeight="SemiBold"/>
         <TextBlock Grid.Row="7" Grid.Column="1" x:Name="AdminText" TextWrapping="Wrap" Margin="0,0,0,11"/>
        </Grid>
        <Button x:Name="ElevateButton" Content="◈  Reiniciar como administrador" HorizontalAlignment="Left"
         Margin="0,8,0,0" Click="Elevate_Click"/>
       </StackPanel>
      </Border>
      <Border Grid.Column="1" Style="{StaticResource Card}" Margin="8,0,0,0">
       <StackPanel>
        <TextBlock Text="ϟ  Acciones rápidas" Style="{StaticResource H2}" Margin="0,0,0,20"/>
        <Button Content="✦   Limpiar archivos temporales" Tag="1" Click="Navigate_Click"
         Background="#E0F2FF" Foreground="#135CA2" Margin="0,0,0,10" HorizontalContentAlignment="Stretch"/>
        <Button Content="◆   Programas y antivirus" Tag="2" Click="Navigate_Click"
         Background="#FCEAF0" Foreground="#B43156" Margin="0,0,0,10"/>
        <Button Content="▤   Actualizar LibreOffice" Tag="3" Click="Navigate_Click"
         Background="#DDF7ED" Foreground="#137C64" Margin="0,0,0,10"/>
        <Button Content="▣   Migración de Windows" Tag="4" Click="Navigate_Click"
         Background="#EEE9FF" Foreground="#5B49AB" Margin="0,0,0,10"/>
        <Button Content="▤   Generar informe" Tag="5" Click="Navigate_Click"
         Background="#DDEFFC" Foreground="#175DAB"/>
       </StackPanel>
      </Border>
     </Grid>

     <UniformGrid Columns="3">
      <Border Style="{StaticResource Card}" Margin="0,0,8,0">
       <StackPanel>
        <TextBlock Text="✔  Estado general" Style="{StaticResource H2}" Margin="0,0,0,13"/>
        <TextBlock x:Name="StateOS" TextWrapping="Wrap" Margin="0,0,0,10"/>
        <TextBlock x:Name="StateDisk" TextWrapping="Wrap" Margin="0,0,0,10"/>
        <TextBlock x:Name="StateAV" TextWrapping="Wrap"/>
       </StackPanel>
      </Border>
      <Border Style="{StaticResource Card}" Margin="8,0,8,0">
       <StackPanel>
        <TextBlock Text="▥  Recursos" Style="{StaticResource H2}" Margin="0,0,0,13"/>
        <TextBlock x:Name="MemoryText" Margin="0,0,0,8" TextWrapping="Wrap"/>
        <ProgressBar x:Name="MemoryBar" Height="13" Foreground="#218BE5" Background="#E5F0F8" Margin="0,0,0,13"/>
        <TextBlock x:Name="FreeDiskText" TextWrapping="Wrap"/>
       </StackPanel>
      </Border>
      <Border Style="{StaticResource Card}" Margin="8,0,0,0">
       <StackPanel>
        <TextBlock Text="✧  Recomendaciones" Style="{StaticResource H2}" Margin="0,0,0,11"/>
        <TextBlock Text="✓ Identificar el puesto físico" TextWrapping="Wrap" Margin="0,0,0,8"/>
        <TextBlock Text="✓ Revisar y previsualizar cambios" TextWrapping="Wrap" Margin="0,0,0,8"/>
        <TextBlock Text="✓ Exportar informe al terminar" TextWrapping="Wrap"/>
       </StackPanel>
      </Border>
     </UniformGrid>
    </StackPanel>

    <!-- MANTENIMIENTO -->
    <StackPanel x:Name="PageMaintenance" Visibility="Collapsed">
     <Border Style="{StaticResource Card}" Margin="0,0,0,15" Background="#DDF7ED">
      <StackPanel>
       <Button x:Name="RunAllMaintenanceButton" Content="Hacer todo el mantenimiento" Click="RunAll_Click"
               Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"/>
       <TextBlock Text="Ejecuta el mantenimiento, actualiza LibreOffice automáticamente y guarda el informe. Antes de comenzar verás la lista completa de cambios para confirmarla."
                  TextWrapping="Wrap" Margin="0,10,0,0"/>
      </StackPanel>
     </Border>
     <Border Style="{StaticResource Card}" Margin="0,0,0,15" Background="#E3F3FF">
      <StackPanel><TextBlock Text="Mantenimiento y limpieza" Style="{StaticResource H1}"/>
       <TextBlock Text="Selecciona lo necesario y comprueba el resultado antes de aplicar cambios." Style="{StaticResource Secondary}" Margin="0,5,0,0"/>
      </StackPanel></Border>
     <Border Style="{StaticResource Card}">
      <StackPanel>
       <TextBlock Text="Operaciones seleccionadas" Style="{StaticResource H2}" Margin="0,0,0,18"/>
       <CheckBox x:Name="TempCheck" Content="Limpiar temporales del usuario de más de 7 días" IsChecked="True"/>
       <CheckBox x:Name="SystemTempCheck" Content="Incluir C:\Windows\Temp (requiere administrador)"/>
       <CheckBox x:Name="CeipCheck" Content="Desactivar participación CEIP/SQM (con copia del valor original)"/>
       <CheckBox x:Name="DiagCheck" Content="Deshabilitar DiagTrack y dmwappushservice (servicios opcionales)"/>
       <CheckBox x:Name="ServicesCheck" Content="Deshabilitar Fax y Windows Media Network Sharing"/>
       <CheckBox x:Name="TabletCheck" Content="Deshabilitar TabletInputService (solo si no hay pantalla táctil)"/>
       <CheckBox x:Name="UpdateLibreCheck" Content="Buscar, descargar e instalar LibreOffice compatible automáticamente"/>
       <CheckBox x:Name="RemoteCheck" Content="Deshabilitar RemoteRegistry (puede afectar la administración remota)"/>
       <WrapPanel Margin="0,12,0,18">
        <Button Content="Vista previa de limpieza" Click="Preview_Click" Margin="0,0,10,10"/>
        <Button Content="Aplicar operaciones seleccionadas" Style="{StaticResource PrimaryButton}" Click="Apply_Click" Margin="0,0,10,10"/>
        <Button Content="Restaurar servicios" Click="Restore_Click" Margin="0,0,10,10"/>
        <Button Content="Restaurar CEIP" Click="RestoreCeip_Click" Margin="0,0,10,10"/>
       </WrapPanel>
       <TextBlock Text="No se desactivan Windows Update, el cortafuegos ni Microsoft Defender. Los archivos eliminados no se pueden restaurar."
                  Style="{StaticResource Secondary}"/>
      </StackPanel>
     </Border>
    </StackPanel>

    <!-- PROGRAMAS -->
    <StackPanel x:Name="PagePrograms" Visibility="Collapsed">
     <Border Style="{StaticResource Card}" Background="#E3F3FF" Margin="0,0,0,15">
      <StackPanel><TextBlock Text="Programas y antivirus" Style="{StaticResource H1}"/>
       <TextBlock Text="Desinstalación supervisada. No se elimina software sin confirmación." Style="{StaticResource Secondary}"/>
      </StackPanel></Border>
     <Border Style="{StaticResource Card}">
      <StackPanel>
       <ListBox x:Name="SoftwareList" Height="360" FontSize="14" DisplayMemberPath="Display" Margin="0,0,0,15"/>
       <WrapPanel><Button Content="Actualizar listado" Click="RefreshSoftware_Click" Margin="0,0,12,10"/>
        <Button Content="Abrir desinstalador" Style="{StaticResource PrimaryButton}" Click="Uninstall_Click" Margin="0,0,12,10"/>
        <Button Content="Programas de Windows" Click="ControlPanel_Click" Margin="0,0,0,10"/>
       </WrapPanel>
       <TextBlock Text="Si se abre el asistente del antivirus, espera a que termine y comprueba después que no sigue instalado."
        Style="{StaticResource Secondary}" Margin="0,10,0,0"/>
      </StackPanel>
     </Border>
    </StackPanel>

    <!-- LIBRE -->
    <StackPanel x:Name="PageLibre" Visibility="Collapsed">
     <Border Style="{StaticResource Card}" Background="#E3F3FF" Margin="0,0,0,15">
      <StackPanel><TextBlock Text="Actualizar LibreOffice" Style="{StaticResource H1}"/>
       <TextBlock Text="Busca, descarga, verifica e instala la versión compatible sin salir de Aula Manager." Style="{StaticResource Secondary}"/>
      </StackPanel></Border>
     <Border Style="{StaticResource Card}">
      <StackPanel>
       <TextBlock x:Name="LibreInstalledText" Style="{StaticResource H2}" Margin="0,0,0,15"/>
       <TextBlock Text="Pulsa Actualizar automáticamente. Se detectan Windows y la arquitectura, se descarga el instalador oficial y se verifica antes de instalar. Guarda tus documentos y cierra LibreOffice."
                  TextWrapping="Wrap" Margin="0,0,0,18"/>
       <TextBlock x:Name="LibreWarningText" Foreground="#B75B20" TextWrapping="Wrap" Margin="0,0,0,18"/>
       <Button Content="Actualizar automáticamente" Click="AutoLibre_Click" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,0,0,12"/>
       <TextBlock x:Name="LibreUpdateText" Text="La actualización también está incluida en Hacer todo el mantenimiento." TextWrapping="Wrap" Margin="0,0,0,16"/>
       <TextBox x:Name="LibreInstallerBox" IsReadOnly="True" Text="No hay instalador seleccionado." Margin="0,0,0,18"/>
       <WrapPanel><Button Content="Seleccionar MSI" Click="ChooseLibre_Click" Margin="0,0,12,10"/>
        <Button Content="Iniciar actualización" Click="RunLibre_Click" Style="{StaticResource PrimaryButton}" Margin="0,0,12,10"/>
        <Button Content="Web oficial" Click="LibreWebsite_Click" Margin="0,0,0,10"/>
       </WrapPanel>
      </StackPanel>
     </Border>
    </StackPanel>

    <!-- MIGRACION -->
    <StackPanel x:Name="PageMigration" Visibility="Collapsed">
     <Border Style="{StaticResource Card}" Background="#E3F3FF" Margin="0,0,0,15">
      <StackPanel><TextBlock Text="Migración de Windows 7 a Windows 10" Style="{StaticResource H1}"/>
       <TextBlock Text="Asistente de comprobación. No realiza ninguna instalación desatendida." Style="{StaticResource Secondary}"/>
      </StackPanel></Border>
     <Border Style="{StaticResource Card}">
      <StackPanel>
       <TextBlock Text="La ISO oficial se prepara desde otro ordenador. Selecciona la carpeta del USB que contiene setup.exe y sources\install.wim o sources\install.esd."
                  TextWrapping="Wrap" Margin="0,0,0,17"/>
       <TextBlock x:Name="MigrationSpecsText" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,15"/>
       <TextBlock Text="Windows 10 terminó su soporte general en octubre de 2025. La instalación necesita una licencia válida. Cambiar de 32 a 64 bits requiere instalación limpia."
                  TextWrapping="Wrap" Foreground="#B06331" Margin="0,0,0,18"/>
       <TextBox x:Name="InstallerFolderBox" IsReadOnly="True" Text="No se ha elegido carpeta." Margin="0,0,0,14"/>
       <WrapPanel Margin="0,0,0,16">
        <Button Content="Seleccionar carpeta ISO / USB" Click="ChooseIso_Click" Margin="0,0,12,10"/>
        <Button Content="Comprobar requisitos" Click="CheckIso_Click" Margin="0,0,0,10"/>
       </WrapPanel>
       <TextBlock x:Name="MigrationResultText" Foreground="#1763A3" TextWrapping="Wrap" Margin="0,0,0,18"/>
       <CheckBox x:Name="BackupCheck" Content="He creado y comprobado una copia de seguridad externa."/>
       <CheckBox x:Name="LicenseCheck" Content="He comprobado licencia, idioma, edición y arquitectura del medio."/>
       <Button Content="Abrir instalador original de Windows" Style="{StaticResource PrimaryButton}"
               Click="LaunchMigration_Click" HorizontalAlignment="Left" Margin="0,15,0,0"/>
      </StackPanel>
     </Border>
    </StackPanel>

    <!-- INFORMES -->
    <StackPanel x:Name="PageReports" Visibility="Collapsed">
     <Border Style="{StaticResource Card}" Background="#E3F3FF" Margin="0,0,0,15">
      <StackPanel><TextBlock Text="Registro e informes" Style="{StaticResource H1}"/>
       <TextBlock Text="Cada actuación queda asociada al centro y al puesto físico." Style="{StaticResource Secondary}"/>
      </StackPanel></Border>
     <Border Style="{StaticResource Card}">
      <StackPanel>
       <TextBlock x:Name="IdentityText" FontWeight="SemiBold" Margin="0,0,0,14" TextWrapping="Wrap"/>
       <TextBox x:Name="LogText" Height="370" IsReadOnly="True" VerticalScrollBarVisibility="Auto"
         HorizontalScrollBarVisibility="Auto" TextWrapping="Wrap" AcceptsReturn="True"
         FontFamily="Consolas" FontSize="12" Margin="0,0,0,15"/>
       <WrapPanel>
        <Button Content="Exportar informe TXT" Click="ExportReport_Click" Style="{StaticResource PrimaryButton}" Margin="0,0,12,10"/>
        <Button Content="Abrir carpeta de informes" Click="OpenReportFolder_Click" Margin="0,0,0,10"/>
       </WrapPanel>
      </StackPanel>
     </Border>
    </StackPanel>

   </Grid>
  </ScrollViewer>

  <Border Grid.Row="1" Grid.ColumnSpan="2" Background="White" BorderBrush="#D7E7F3" BorderThickness="0,1,0,0">
   <Grid Margin="23,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <TextBlock x:Name="StatusText" Text="Listo" Foreground="#109D74" FontWeight="SemiBold" VerticalAlignment="Center"/>
    <TextBlock Grid.Column="1" Text="     Modo portable   ·   Datos y registros junto al ejecutable   ·   Ningún cambio automático"
     Foreground="#6C88A6" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
   </Grid>
  </Border>
 </Grid>
</Window>
